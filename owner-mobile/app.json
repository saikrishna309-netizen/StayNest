{
  "expo": {
    "name": "StayNest-PG Owner",
    "slug": "staynest-pg-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.staynest.owner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "StayNest needs camera access to capture room, property, and profile photos.",
        "NSPhotoLibraryUsageDescription": "StayNest needs photo library access to upload cover banners, profile photos, and room images.",
        "NSPhotoLibraryAddUsageDescription": "StayNest needs permission to save rent receipts and invoices to your photo library.",
        "NSLocationWhenInUseUsageDescription": "StayNest uses your location to auto-fill your PG or rental property address.",
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "tez",
          "gpay",
          "paytmmp",
          "upi",
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "in.staynest.owner",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withUpiQueries"
    ],
    "extra": {
      "apiUrl": "https://staynest-6ylx.onrender.com/api/v1",
      "eas": {
        "projectId": "6c4155e5-d060-4475-ac4c-656032a38d1c"
      }
    }
  }
}
