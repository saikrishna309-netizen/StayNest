### =============================================================================
### StayNest - Complete API Collection (REST Client for VS Code)
### =============================================================================
### How to use in VS Code:
### 1. Install the "REST Client" extension (by Huachao Mao) in VS Code.
### 2. A clickable "Send Request" button will appear above each HTTP request below.
### 3. Click "Send Request" on Step 1.2 (Login) - it automatically saves the JWT token!
### 4. Run any authenticated request below and it will use the saved token!
### =============================================================================

@baseUrl = http://localhost:8080/api/v1

### -----------------------------------------------------------------------------
### 1. AUTHENTICATION & ONBOARDING
### -----------------------------------------------------------------------------

### 1.1 Register New Account (Customer or Owner)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Ananya Verma",
  "email": "ananya.verma@example.com",
  "phone": "9876543210",
  "password": "Password@123456",
  "role": "ROLE_CUSTOMER"
}

### 1.2 Login as Admin (Auto-captures Token)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@staynest.in",
  "password": "Admin@123456"
}

### Store Admin Token
@adminToken = {{loginAdmin.response.body.accessToken}}

### 1.3 Login as Property Owner (Auto-captures Token)
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "owner@staynest.in",
  "password": "Owner@123456"
}

### Store Owner Token
@ownerToken = {{loginOwner.response.body.accessToken}}

### 1.4 Login as Customer (Auto-captures Token)
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer@staynest.in",
  "password": "Customer@123456"
}

### Store Customer Token
@customerToken = {{loginCustomer.response.body.accessToken}}

### 1.5 Refresh Access Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginCustomer.response.body.refreshToken}}"
}

### 1.6 Verify Email Address
POST {{baseUrl}}/auth/verify-email
Content-Type: application/json

{
  "email": "customer@staynest.in",
  "token": "sample-email-verification-token"
}

### 1.7 Verify Phone with OTP
POST {{baseUrl}}/auth/verify-phone
Content-Type: application/json

{
  "phone": "9777722222",
  "otp": "123456"
}

### 1.8 Forgot Password (Generate Reset Token)
# @name forgotPassword
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "customer@staynest.in"
}

### 1.9 Reset Password with Token
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "{{forgotPassword.response.body.resetToken}}",
  "newPassword": "NewPassword@123456"
}

### 1.10 Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{customerToken}}

### -----------------------------------------------------------------------------
### 2. USER PROFILE (CURRENT AUTHENTICATED USER)
### -----------------------------------------------------------------------------

### 2.1 Get Current User Profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}

### 2.2 Update Profile
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "fullName": "Priya S. Sharma",
  "phone": "9777722222",
  "emergencyContact": "9888800000"
}

### -----------------------------------------------------------------------------
### 3. PUBLIC PROPERTY DISCOVERY & SEARCH
### -----------------------------------------------------------------------------

### 3.1 List Supported Cities
# @name getCities
GET {{baseUrl}}/cities

### Store Bengaluru City ID
@cityId = {{getCities.response.body[0].id}}

### 3.2 List Localities for a City
# @name getLocalities
GET {{baseUrl}}/localities?cityId={{cityId}}

### Store First Locality ID
@localityId = {{getLocalities.response.body[0].id}}

### 3.3 Search & Filter Properties (with Pagination & Filters)
# @name searchProperties
GET {{baseUrl}}/properties?cityId={{cityId}}&genderPolicy=CO_ED&minRent=500000&maxRent=2000000&foodIncluded=true&page=0&size=10

### 3.4 Get Published Property Details
# @name getPropertyDetails
GET {{baseUrl}}/properties/f1111111-1111-1111-1111-111111111111

### 3.5 Check Bed Availability for Date Range
GET {{baseUrl}}/properties/f1111111-1111-1111-1111-111111111111/availability?checkIn=2026-12-01&checkOut=2027-05-31

### 3.6 Get Property Reviews
GET {{baseUrl}}/properties/f1111111-1111-1111-1111-111111111111/reviews

### -----------------------------------------------------------------------------
### 4. OWNER PROPERTIES & INVENTORY MANAGEMENT
### -----------------------------------------------------------------------------

### 4.1 List Owner's Properties
GET {{baseUrl}}/owner/properties
Authorization: Bearer {{ownerToken}}

### 4.2 Create New Draft Property
# @name createDraftProperty
POST {{baseUrl}}/owner/properties
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "StayNest Green View PG",
  "propertyType": "PG",
  "genderPolicy": "BOYS",
  "description": "Spacious PG with power backup, high-speed Wi-Fi and attached washroom in Koramangala.",
  "cityId": "{{cityId}}",
  "localityId": "{{localityId}}",
  "addressLine": "#88, 5th Cross, 6th Block, Koramangala",
  "pincode": "560034",
  "latitude": 12.9352,
  "longitude": 77.6245,
  "startingPricePaise": 900000,
  "noticePeriodDays": 30,
  "depositMonths": 1,
  "foodIncluded": true,
  "payAtPropertyAllowed": true,
  "rules": "Gates close at 11 PM. No loud music after 10 PM.",
  "cancellationPolicy": "Full refund if cancelled 7 days before check-in.",
  "amenityCodes": ["WIFI", "AC", "FOOD", "POWER_BACKUP", "RO_WATER"]
}

### Store Created Property ID
@newPropertyId = {{createDraftProperty.response.body.id}}

### 4.3 Get Owner Property Details
GET {{baseUrl}}/owner/properties/{{newPropertyId}}
Authorization: Bearer {{ownerToken}}

### 4.4 Update Property Details
PATCH {{baseUrl}}/owner/properties/{{newPropertyId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "startingPricePaise": 950000,
  "rules": "Quiet hours 10:30 PM to 6:30 AM."
}

### 4.5 Add Photo to Property
POST {{baseUrl}}/owner/properties/{{newPropertyId}}/photos
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "photoUrl": "https://images.unsplash.com/photo-1555854877-bab0e564b8d5",
  "caption": "Spacious Double Sharing Room",
  "displayOrder": 1,
  "cover": true
}

### 4.6 Create Room inside Property
# @name createRoom
POST {{baseUrl}}/owner/properties/{{newPropertyId}}/rooms
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "roomNumber": "201",
  "sharingType": "DOUBLE",
  "capacity": 2,
  "floorNumber": 2,
  "rentMonthlyPaise": 950000,
  "depositPaise": 950000
}

### Store Created Room ID
@newRoomId = {{createRoom.response.body.id}}

### 4.7 Update Room Details
PATCH {{baseUrl}}/owner/rooms/{{newRoomId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "rentMonthlyPaise": 1000000
}

### 4.8 Create Bed inside Room
# @name createBed
POST {{baseUrl}}/owner/rooms/{{newRoomId}}/beds
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "bedLabel": "Bed 201-A"
}

### Store Created Bed ID
@newBedId = {{createBed.response.body.id}}

### 4.9 Update Bed Status
PATCH {{baseUrl}}/owner/beds/{{newBedId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "bedLabel": "Bed 201-A (Window Side)",
  "status": "AVAILABLE"
}

### 4.10 Submit Draft Property for Platform Approval
POST {{baseUrl}}/owner/properties/{{newPropertyId}}/submit
Authorization: Bearer {{ownerToken}}

### -----------------------------------------------------------------------------
### 5. ADMIN PLATFORM MODERATION & DIRECTORY
### -----------------------------------------------------------------------------

### 5.1 Review Pending Listings Moderation Queue
GET {{baseUrl}}/admin/properties/pending
Authorization: Bearer {{adminToken}}

### 5.2 Approve Property Listing
POST {{baseUrl}}/admin/properties/{{newPropertyId}}/approve
Authorization: Bearer {{adminToken}}

### 5.3 Reject Property Listing (Alternative)
# POST {{baseUrl}}/admin/properties/{{newPropertyId}}/reject
# Authorization: Bearer {{adminToken}}
# Content-Type: application/json
#
# {
#   "rejectionReason": "Please provide clearer room photos and complete address details."
# }

### 5.4 List Users Across Platform
GET {{baseUrl}}/admin/users?page=0&size=20
Authorization: Bearer {{adminToken}}

### 5.5 Platform Subscription Health Overview
GET {{baseUrl}}/admin/subscriptions
Authorization: Bearer {{adminToken}}

### 5.6 View Platform Audit Logs
GET {{baseUrl}}/admin/audit-logs?page=0&size=20
Authorization: Bearer {{adminToken}}

### -----------------------------------------------------------------------------
### 6. BOOKING ENGINE & RESERVATIONS
### -----------------------------------------------------------------------------

### 6.1 Create 15-Minute Temporary Hold on a Bed
# @name createHold
POST {{baseUrl}}/bookings/holds
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "roomId": "a1111111-1111-1111-1111-111111111111",
  "bedId": "b0000001-0000-0000-0000-000000000001",
  "checkInDate": "2026-12-01",
  "checkOutDate": "2027-05-31"
}

### Store Hold ID
@holdId = {{createHold.response.body.holdId}}

### 6.2 Confirm Booking (with Idempotency Key)
# @name createBooking
POST {{baseUrl}}/bookings
Authorization: Bearer {{customerToken}}
Idempotency-Key: test-idempotency-key-001
Content-Type: application/json

{
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "roomId": "a1111111-1111-1111-1111-111111111111",
  "bedId": "b0000001-0000-0000-0000-000000000001",
  "holdId": "{{holdId}}",
  "checkInDate": "2026-12-01",
  "checkOutDate": "2027-05-31",
  "rentMonthlyPaise": 950000,
  "depositPaise": 950000,
  "specialRequests": "Vegetarian meal plan requested"
}

### Store Booking ID
@bookingId = {{createBooking.response.body.id}}

### 6.3 Get Booking Details
GET {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{customerToken}}

### 6.4 List Customer's Bookings
GET {{baseUrl}}/customer/bookings?page=0&size=10
Authorization: Bearer {{customerToken}}

### 6.5 List Owner's Bookings Across Properties
GET {{baseUrl}}/owner/bookings?page=0&size=10
Authorization: Bearer {{ownerToken}}

### 6.6 Owner Check-In Tenant
POST {{baseUrl}}/owner/bookings/{{bookingId}}/check-in
Authorization: Bearer {{ownerToken}}

### 6.7 Owner Check-Out Tenant
POST {{baseUrl}}/owner/bookings/{{bookingId}}/check-out
Authorization: Bearer {{ownerToken}}

### 6.8 Cancel Booking (if needed)
# POST {{baseUrl}}/bookings/{{bookingId}}/cancel
# Authorization: Bearer {{customerToken}}
# Content-Type: application/json
#
# {
#   "reason": "Change of internship location to Pune"
# }

### -----------------------------------------------------------------------------
### 7. PAYMENTS, ORDERS & SETTLEMENTS
### -----------------------------------------------------------------------------

### 7.1 Create Gateway Order for Booking
# @name createOrder
POST {{baseUrl}}/payments/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "amountPaise": 950000,
  "paymentType": "BOOKING_ADVANCE",
  "paymentMethod": "ONLINE",
  "gatewayProvider": "RAZORPAY"
}

### Store Payment ID
@paymentId = {{createOrder.response.body.paymentId}}

### 7.2 Get Payment Status
GET {{baseUrl}}/payments/{{paymentId}}
Authorization: Bearer {{customerToken}}

### 7.3 Receive Payment Webhook from Gateway
POST {{baseUrl}}/payments/webhooks/razorpay
Content-Type: application/json

{
  "event": "payment.captured",
  "payload": {
    "payment": {
      "entity": {
        "id": "pay_mock_123456789",
        "order_id": "{{createOrder.response.body.gatewayOrderId}}",
        "amount": 950000,
        "status": "captured"
      }
    }
  }
}

### 7.4 Initiate Refund for Payment
POST {{baseUrl}}/payments/{{paymentId}}/refunds
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "amountPaise": 500000,
  "reason": "Cancellation fee deducted; partial advance refunded"
}

### 7.5 Owner Financial Payment Collections View
GET {{baseUrl}}/owner/payments?page=0&size=20
Authorization: Bearer {{ownerToken}}

### -----------------------------------------------------------------------------
### 8. TENANT & PROPERTY MANAGEMENT SYSTEM (PMS)
### -----------------------------------------------------------------------------

### 8.1 Onboard New Tenant
# @name createTenant
POST {{baseUrl}}/owner/tenants
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "fullName": "Rahul Deshmukh",
  "phone": "9811122233",
  "email": "rahul.d@example.com",
  "emergencyContact": "9811100099",
  "idProofType": "AADHAAR",
  "idProofNumber": "1234-5678-9012"
}

### Store Tenant ID
@tenantId = {{createTenant.response.body.id}}

### 8.2 List Tenants
GET {{baseUrl}}/owner/tenants?page=0&size=20
Authorization: Bearer {{ownerToken}}

### 8.3 Get Single Tenant Profile
GET {{baseUrl}}/owner/tenants/{{tenantId}}
Authorization: Bearer {{ownerToken}}

### 8.4 Record Tenant Stay (Bed Allocation)
POST {{baseUrl}}/owner/tenants/{{tenantId}}/stays
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "roomId": "a1111111-1111-1111-1111-111111111111",
  "bedId": "b0000002-0000-0000-0000-000000000002",
  "startDate": "2026-11-01",
  "rentMonthlyPaise": 950000,
  "depositPaise": 950000
}

### 8.5 Generate Monthly Rent Invoice
# @name createRentInvoice
POST {{baseUrl}}/owner/rent-invoices
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "tenantId": "{{tenantId}}",
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "billingPeriod": "2026-11",
  "amountPaise": 950000,
  "dueDate": "2026-11-05"
}

### Store Invoice ID
@invoiceId = {{createRentInvoice.response.body.id}}

### 8.6 List Rent Invoices
GET {{baseUrl}}/owner/rent-invoices?page=0&size=20
Authorization: Bearer {{ownerToken}}

### 8.7 Record Offline Rent Collection (Cash / UPI / Bank Transfer)
POST {{baseUrl}}/owner/rent-invoices/{{invoiceId}}/payments
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "amountPaise": 950000,
  "paymentMode": "UPI",
  "referenceNumber": "UPI-REF-99887766"
}

### 8.8 Record Auxiliary Property Income
POST {{baseUrl}}/owner/income
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "category": "LAUNDRY",
  "amountPaise": 50000,
  "paymentMode": "CASH",
  "notes": "Extra laundry service charge for Nov"
}

### 8.9 List Property Income Entries
GET {{baseUrl}}/owner/income?page=0&size=20
Authorization: Bearer {{ownerToken}}

### 8.10 Record Property Expense
POST {{baseUrl}}/owner/expenses
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "propertyId": "f1111111-1111-1111-1111-111111111111",
  "category": "ELECTRICITY",
  "amountPaise": 1850000,
  "paymentMode": "ONLINE",
  "paidTo": "BESCOM Electricity Board",
  "notes": "Electricity bill for Oct-Nov 2026"
}

### 8.11 List Property Expenses
GET {{baseUrl}}/owner/expenses?page=0&size=20
Authorization: Bearer {{ownerToken}}

### 8.12 Get Monthly Financial P&L Report
GET {{baseUrl}}/owner/reports/monthly?month=2026-11
Authorization: Bearer {{ownerToken}}

### 8.13 Get Occupancy & Bed Utilization Report
GET {{baseUrl}}/owner/reports/occupancy
Authorization: Bearer {{ownerToken}}

### 8.14 Download Financial CSV Report
GET {{baseUrl}}/owner/reports/export?format=csv
Authorization: Bearer {{ownerToken}}

### -----------------------------------------------------------------------------
### 9. OWNER SAAS SUBSCRIPTION PLANS
### -----------------------------------------------------------------------------

### 9.1 List SaaS Subscription Plans
GET {{baseUrl}}/subscription-plans

### 9.2 Start or Upgrade Owner Subscription
POST {{baseUrl}}/owner/subscriptions
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "planCode": "GROWTH",
  "billingCycle": "MONTHLY"
}

### 9.3 Get Owner Current Active Subscription
GET {{baseUrl}}/owner/subscription
Authorization: Bearer {{ownerToken}}

### 9.4 Subscription Recurring Webhook
POST {{baseUrl}}/subscriptions/webhooks/razorpay
Content-Type: application/json

{
  "event": "subscription.charged",
  "payload": {
    "subscription": {
      "id": "sub_mock_12345",
      "status": "active"
    }
  }
}

